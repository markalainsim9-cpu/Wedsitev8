rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Event configuration details & metadata
    match /event_config/{docId} {
      allow read, write: if true;
    }

    // App configuration & deletion tombstones
    match /config/{docId} {
      allow read, write: if true;
    }
    
    // Guest list & RSVP responses
    match /guests/{guestId} {
      allow read, write: if true;
    }

    // Guestbook wishes and notes
    match /guestbook/{entryId} {
      allow read, write: if true;
    }

    // Guestbook initialization and deletion metadata
    match /guestbook_meta/{docId} {
      allow read, write: if true;
    }

    // Connection probe test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
