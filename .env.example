# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IMAGEKIT_PUBLIC_KEY: Public API key from ImageKit.io developer dashboard.
IMAGEKIT_PUBLIC_KEY=

# IMAGEKIT_PRIVATE_KEY: Secret private API key from ImageKit.io developer dashboard (server-side only).
IMAGEKIT_PRIVATE_KEY=

# IMAGEKIT_URL_ENDPOINT: ImageKit URL endpoint (e.g. https://ik.imagekit.io/your_id).
IMAGEKIT_URL_ENDPOINT=

# CLOUDFLARE R2 STORAGE (Video Guestbook & Media Uploads)
# CLOUDFLARE_R2_ACCOUNT_ID: Cloudflare Account ID from Cloudflare dashboard or R2 overview.
CLOUDFLARE_R2_ACCOUNT_ID=

# CLOUDFLARE_R2_ACCESS_KEY_ID: Cloudflare R2 API Token Access Key ID.
CLOUDFLARE_R2_ACCESS_KEY_ID=

# CLOUDFLARE_R2_SECRET_ACCESS_KEY: Cloudflare R2 API Token Secret Access Key (server-side only).
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# CLOUDFLARE_R2_BUCKET_NAME: Name of the Cloudflare R2 bucket created for video/media storage.
CLOUDFLARE_R2_BUCKET_NAME=

# CLOUDFLARE_R2_PUBLIC_URL: Public domain/URL for the bucket (e.g. https://pub-xxx.r2.dev or https://media.yourdomain.com).
CLOUDFLARE_R2_PUBLIC_URL=

